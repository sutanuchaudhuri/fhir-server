meta {
  name: Update Patient
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/{{fhirVersion}}/Patient/{{lastCreatedPatientId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Patient",
    "id": "{{lastCreatedPatientId}}",
    "meta": {
      "security": [
        {
          "system": "https://www.icanbwell.com/owner",
          "code": "client"
        },
        {
          "system": "https://www.icanbwell.com/access",
          "code": "client"
        },
        {
          "system": "https://www.icanbwell.com/sourceAssigningAuthority",
          "code": "client"
        }
      ]
    },
    "active": true,
    "name": [
      {
        "use": "official",
        "family": "Doe",
        "given": ["John", "Michael"],
        "prefix": ["Mr."]
      }
    ],
    "telecom": [
      {
        "system": "phone",
        "value": "555-123-4567",
        "use": "home"
      },
      {
        "system": "phone",
        "value": "555-555-1234",
        "use": "mobile"
      },
      {
        "system": "email",
        "value": "john.doe@example.com",
        "use": "home"
      }
    ],
    "gender": "male",
    "birthDate": "1985-03-15",
    "address": [
      {
        "use": "home",
        "type": "both",
        "line": ["456 Oak Avenue", "Unit 2A"],
        "city": "New York",
        "state": "NY",
        "postalCode": "10002",
        "country": "US"
      }
    ],
    "maritalStatus": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/v3-MaritalStatus",
          "code": "M",
          "display": "Married"
        }
      ]
    }
  }
}

script:post-response {
  if (res.status === 200) {
    console.log("✅ Patient updated successfully");
    console.log("Updated Patient ID:", res.body.id);
    console.log("New address:", res.body.address?.[0]?.line?.join(", "));
    console.log("Phone numbers:", res.body.telecom?.filter(t => t.system === "phone").map(t => t.value).join(", "));
  } else {
    console.log("❌ Failed to update patient:", res.status, res.body);
  }
}
