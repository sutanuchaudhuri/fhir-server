meta {
  name: Add Address to Patient
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/{{fhirVersion}}/Patient/{{lastCreatedPatientId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Patient",
    "id": "{{lastCreatedPatientId}}",
    "active": true,
    "name": [
      {
        "use": "official",
        "family": "Doe",
        "given": ["John", "Michael"],
        "prefix": ["Mr."]
      }
    ],
    "telecom": [
      {
        "system": "phone",
        "value": "555-123-4567",
        "use": "home"
      },
      {
        "system": "phone",
        "value": "555-555-1234",
        "use": "mobile"
      },
      {
        "system": "email",
        "value": "john.doe@example.com",
        "use": "home"
      }
    ],
    "gender": "male",
    "birthDate": "1985-03-15",
    "address": [
      {
        "use": "home",
        "type": "both",
        "line": ["456 Oak Avenue", "Unit 2A"],
        "city": "New York",
        "state": "NY",
        "postalCode": "10002",
        "country": "US",
        "period": {
          "start": "2020-01-01"
        }
      },
      {
        "use": "work",
        "type": "both",
        "line": ["789 Business Plaza", "Suite 100"],
        "city": "New York",
        "state": "NY",
        "postalCode": "10003",
        "country": "US",
        "period": {
          "start": "2023-06-01"
        }
      }
    ],
    "maritalStatus": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/v3-MaritalStatus",
          "code": "M",
          "display": "Married"
        }
      ]
    }
  }
}

script:post-response {
  if (res.status === 200) {
    console.log("✅ Patient address added successfully");
    console.log("Updated Patient ID:", res.body.id);
    console.log("Total addresses:", res.body.address?.length || 0);
    if (res.body.address) {
      res.body.address.forEach((addr, index) => {
        console.log(`Address ${index + 1} (${addr.use}):`, addr.line?.join(", "), addr.city, addr.state);
      });
    }
  } else {
    console.log("❌ Failed to add address to patient:", res.status, res.body);
  }
}
