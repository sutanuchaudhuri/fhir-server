meta {
  name: Add General Practitioner to Patient
  type: http
  seq: 16
}

put {
  url: {{baseUrl}}/{{fhirVersion}}/Patient/{{lastCreatedPatientId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Patient",
    "id": "{{lastCreatedPatientId}}",
    "active": true,
    "name": [
      {
        "use": "official",
        "family": "Doe",
        "given": ["John", "Michael"],
        "prefix": ["Mr."]
      }
    ],
    "telecom": [
      {
        "system": "phone",
        "value": "555-123-4567",
        "use": "home"
      },
      {
        "system": "phone",
        "value": "555-555-1234",
        "use": "mobile"
      },
      {
        "system": "email",
        "value": "john.doe@example.com",
        "use": "home"
      }
    ],
    "gender": "male",
    "birthDate": "1985-03-15",
    "address": [
      {
        "use": "home",
        "type": "both",
        "line": ["456 Oak Avenue", "Unit 2A"],
        "city": "New York",
        "state": "NY",
        "postalCode": "10002",
        "country": "US"
      }
    ],
    "maritalStatus": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/v3-MaritalStatus",
          "code": "M",
          "display": "Married"
        }
      ]
    },
    "generalPractitioner": [
      {
        "reference": "Practitioner/{{lastCreatedPractitionerId}}",
        "display": "Dr. Emily Smith, MD"
      }
    ]
  }
}

script:post-response {
  if (res.status === 200) {
    console.log("✅ General Practitioner assigned to patient successfully");
    console.log("Updated Patient ID:", res.body.id);
    console.log("General Practitioner:", res.body.generalPractitioner?.[0]?.display);
    console.log("GP Reference:", res.body.generalPractitioner?.[0]?.reference);
  } else {
    console.log("❌ Failed to assign GP to patient:", res.status, res.body);
  }
}
