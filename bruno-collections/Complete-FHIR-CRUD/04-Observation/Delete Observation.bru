meta {
  name: Delete Observation
  type: http
  seq: 88
}

delete {
  url: {{baseUrl}}/{{fhirVersion}}/Observation/{{lastCreatedObservationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
}

script:post-response {
  if (res.status === 200 || res.status === 204) {
    console.log("✅ Observation deleted successfully");
    console.log("Status:", res.status);
    
    if (res.body && res.body.resourceType === "OperationOutcome") {
      console.log("\n📋 Operation Details:");
      console.log("Severity:", res.body.issue?.[0]?.severity);
      console.log("Code:", res.body.issue?.[0]?.code);
      console.log("Details:", res.body.issue?.[0]?.details?.text || res.body.issue?.[0]?.diagnostics);
    }
    
    console.log("\n🗑️ Cleanup Actions:");
    console.log("Removing observationId from environment...");
    
    // Clear the environment variable
    bru.setEnvVar("lastCreatedObservationId", "");
    
    console.log("✅ Environment cleaned up successfully");
    console.log("Note: Related observations and derived observations may need separate cleanup");
    
  } else if (res.status === 404) {
    console.log("⚠️ Observation not found (already deleted or never existed)");
    console.log("Cleaning up environment variable anyway...");
    bru.setEnvVar("lastCreatedObservationId", "");
    
  } else if (res.status === 410) {
    console.log("⚠️ Observation was already deleted");
    console.log("Resource is marked as deleted but may still exist in history");
    bru.setEnvVar("lastCreatedObservationId", "");
    
  } else {
    console.log("❌ Failed to delete Observation");
    console.log("Status:", res.status);
    console.log("Response:", res.body);
    
    if (res.body && res.body.resourceType === "OperationOutcome") {
      console.log("\n❌ Error Details:");
      if (res.body.issue && res.body.issue.length > 0) {
        res.body.issue.forEach((issue, index) => {
          console.log(`Issue ${index + 1}:`);
          console.log("  Severity:", issue.severity);
          console.log("  Code:", issue.code);
          console.log("  Details:", issue.details?.text || issue.diagnostics);
          if (issue.location) {
            console.log("  Location:", issue.location.join(", "));
          }
          if (issue.expression) {
            console.log("  Expression:", issue.expression.join(", "));
          }
        });
      }
    }
    
    console.log("\n🔧 Troubleshooting Tips:");
    console.log("1. Verify the Observation ID exists");
    console.log("2. Check if you have permission to delete this resource");
    console.log("3. Ensure the resource is not referenced by other resources");
    console.log("4. Check if the observation is part of an active care plan");
    console.log("5. Verify server supports DELETE operations");
  }
}
