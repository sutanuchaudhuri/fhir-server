meta {
  name: Create CareTeam
  type: http
  seq: 48
}

post {
  url: {{baseUrl}}/{{fhirVersion}}/CareTeam
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

