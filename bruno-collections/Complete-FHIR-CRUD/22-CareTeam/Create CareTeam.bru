script:post-response {
  if (res.status === 201) {
    console.log("✅ CareTeam created successfully");
    console.log("CareTeam ID:", res.body.id);
    console.log("Status:", res.body.status);
    console.log("Name:", res.body.name);
    console.log("Subject:", res.body.subject?.display);
    console.log("Period:", res.body.period?.start, "to", res.body.period?.end);
    console.log("Participants:", res.body.participant?.length || 0);
    
    if (res.body.category && res.body.category.length > 0) {
      console.log("Categories:", res.body.category.map(c => c.coding?.[0]?.display).join(", "));
    }
    
    if (res.body.participant && res.body.participant.length > 0) {
      console.log("\n👥 Team Members:");
      res.body.participant.forEach((participant, index) => {
        const role = participant.role?.[0]?.coding?.[0]?.display || "Unknown Role";
        const member = participant.member?.display || participant.member?.reference;
        const organization = participant.onBehalfOf?.display || "";
        const period = participant.period?.start;
        
        console.log(`${index + 1}. ${member}`);
        console.log(`   Role: ${role}`);
        if (organization) {
          console.log(`   Organization: ${organization}`);
        }
        console.log(`   Start Date: ${period}`);
        console.log("");
      });
    }
    
    if (res.body.reasonCode && res.body.reasonCode.length > 0) {
      console.log("🎯 Reason Codes:");
      res.body.reasonCode.forEach((reason, index) => {
        console.log(`${index + 1}. ${reason.coding?.[0]?.display}`);
      });
    }
    
    if (res.body.managingOrganization && res.body.managingOrganization.length > 0) {
      console.log("\n🏥 Managing Organizations:");
      res.body.managingOrganization.forEach((org, index) => {
        console.log(`${index + 1}. ${org.display || org.reference}`);
      });
    }
    
    // Store the care team ID for other requests
    bru.setEnvVar("lastCreatedCareTeamId", res.body.id);
  } else {
    console.log("❌ Failed to create care team:", res.status, res.body);
  }
}
