meta {
  name: Delete Appointment
  type: http
  seq: 30
}

delete {
  url: {{baseUrl}}/{{fhirVersion}}/Appointment/{{lastCreatedAppointmentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
}

script:post-response {
  if (res.status === 200 || res.status === 204) {
    console.log("✅ Appointment deleted successfully");
    console.log("Deleted Appointment ID:", "{{lastCreatedAppointmentId}}");
    console.log("Response status:", res.status);
    
    // Clear the environment variable
    bru.setEnvVar("lastCreatedAppointmentId", "");
  } else if (res.status === 404) {
    console.log("⚠️  Appointment not found (already deleted or never existed)");
  } else {
    console.log("❌ Failed to delete appointment:", res.status, res.body);
  }
}
