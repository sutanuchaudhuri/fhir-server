meta {
  name: Update Appointment
  type: http
  seq: 31
}

put {
  url: {{baseUrl}}/{{fhirVersion}}/Appointment/{{lastCreatedAppointmentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Appointment",
    "id": "{{lastCreatedAppointmentId}}",
    "status": "confirmed",
    "serviceCategory": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/service-category",
            "code": "27",
            "display": "Specialist Medical"
          }
        ]
      }
    ],
    "serviceType": [
      {
        "coding": [
          {
            "system": "http://snomed.info/sct",
            "code": "394579002",
            "display": "Cardiology"
          }
        ]
      }
    ],
    "specialty": [
      {
        "coding": [
          {
            "system": "http://snomed.info/sct",
            "code": "394579002",
            "display": "Cardiology"
          }
        ]
      }
    ],
    "appointmentType": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/v2-0276",
          "code": "FOLLOWUP",
          "display": "Follow-up"
        }
      ]
    },
    "reasonCode": [
      {
        "coding": [
          {
            "system": "http://snomed.info/sct",
            "code": "84114007",
            "display": "Heart failure"
          }
        ],
        "text": "Follow-up for heart failure management"
      }
    ],
    "priority": 5,
    "description": "Follow-up cardiology appointment for heart failure management and medication adjustment",
    "start": "2024-02-15T14:00:00Z",
    "end": "2024-02-15T15:00:00Z",
    "minutesDuration": 60,
    "slot": [
      {
        "reference": "Slot/cardiology-slot-003"
      }
    ],
    "created": "2024-01-25T10:30:00Z",
    "comment": "Patient requested afternoon appointment. Bring current medication list and recent test results.",
    "patientInstruction": "Please arrive 15 minutes early. Bring your current medications, insurance card, and any recent test results. Fasting is not required.",
    "basedOn": [
      {
        "reference": "ServiceRequest/cardiology-referral-001"
      }
    ],
    "participant": [
      {
        "type": [
          {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/v3-ParticipationType",
                "code": "PPRF",
                "display": "primary performer"
              }
            ]
          }
        ],
        "actor": {
          "reference": "Practitioner/{{lastCreatedPractitionerId}}",
          "display": "Dr. Emily Smith - Cardiologist"
        },
        "required": "required",
        "status": "accepted"
      },
      {
        "type": [
          {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/v3-ParticipationType",
                "code": "SBJ",
                "display": "subject"
              }
            ]
          }
        ],
        "actor": {
          "reference": "Patient/{{lastCreatedPatientId}}",
          "display": "Patient"
        },
        "required": "required",
        "status": "accepted"
      },
      {
        "type": [
          {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/v3-ParticipationType",
                "code": "LOC",
                "display": "location"
              }
            ]
          }
        ],
        "actor": {
          "reference": "Location/cardiology-room-b",
          "display": "Cardiology Clinic - Room B"
        },
        "required": "required",
        "status": "accepted"
      }
    ],
    "requestedPeriod": [
      {
        "start": "2024-02-15T13:00:00Z",
        "end": "2024-02-15T17:00:00Z"
      }
    ]
  }
}

script:post-response {
  if (res.status === 200) {
    console.log("✅ Appointment updated successfully");
    console.log("Appointment ID:", res.body.id);
    console.log("Status:", res.body.status);
    console.log("Type:", res.body.appointmentType?.coding?.[0]?.display);
    console.log("Service:", res.body.serviceType?.[0]?.coding?.[0]?.display);
    console.log("Updated Start:", res.body.start);
    console.log("Updated End:", res.body.end);
    console.log("Duration:", res.body.minutesDuration, "minutes");
    console.log("Participants:", res.body.participant?.length || 0);
    console.log("Reason:", res.body.reasonCode?.[0]?.text || res.body.reasonCode?.[0]?.coding?.[0]?.display);
  } else {
    console.log("❌ Failed to update appointment:", res.status, res.body);
  }
}
