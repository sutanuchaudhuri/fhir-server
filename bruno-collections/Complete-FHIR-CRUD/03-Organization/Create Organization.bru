meta {
  name: Create Organization
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/{{fhirVersion}}/Organization
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Organization",
    "meta": {
      "security": [
        {
          "system": "https://www.icanbwell.com/owner",
          "code": "client"
        },
        {
          "system": "https://www.icanbwell.com/access",
          "code": "client"
        },
        {
          "system": "https://www.icanbwell.com/sourceAssigningAuthority",
          "code": "client"
        }
      ]
    },
    "active": true,
    "type": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/organization-type",
            "code": "prov",
            "display": "Healthcare Provider"
          }
        ]
      }
    ],
    "name": "City General Hospital",
    "alias": ["CGH", "City General"],
    "telecom": [
      {
        "system": "phone",
        "value": "555-111-2222",
        "use": "work"
      },
      {
        "system": "email",
        "value": "info@citygeneral.com",
        "use": "work"
      },
      {
        "system": "url",
        "value": "https://www.citygeneral.com",
        "use": "work"
      }
    ],
    "address": [
      {
        "use": "work",
        "type": "physical",
        "line": ["1234 Healthcare Blvd"],
        "city": "Chicago",
        "state": "IL",
        "postalCode": "60601",
        "country": "US"
      }
    ],
    "contact": [
      {
        "purpose": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/contactentity-type",
              "code": "ADMIN",
              "display": "Administrative"
            }
          ]
        },
        "name": {
          "family": "Anderson",
          "given": ["Robert"]
        },
        "telecom": [
          {
            "system": "phone",
            "value": "555-111-2223",
            "use": "work"
          },
          {
            "system": "email",
            "value": "r.anderson@citygeneral.com",
            "use": "work"
          }
        ]
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    console.log("✅ Organization created successfully");
    console.log("Organization ID:", res.body.id);
    console.log("Name:", res.body.name);
    console.log("Type:", res.body.type?.[0]?.coding?.[0]?.display);
    console.log("Active:", res.body.active);
    
    // Store the organization ID for use in other requests
    bru.setVar("lastCreatedOrganizationId", res.body.id);
  } else {
    console.log("❌ Failed to create organization:", res.status, res.body);
  }
}
