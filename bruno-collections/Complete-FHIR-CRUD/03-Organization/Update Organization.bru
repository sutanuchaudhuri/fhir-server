meta {
  name: Update Organization
  type: http
  seq: 56
}

put {
  url: {{baseUrl}}/{{fhirVersion}}/Organization/{{lastCreatedOrganizationId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Organization",
    "id": "{{lastCreatedOrganizationId}}",
    "active": true,
    "type": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/organization-type",
            "code": "prov",
            "display": "Healthcare Provider"
          }
        ]
      }
    ],
    "name": "General Hospital - Updated",
    "alias": [
      "GH Medical Center",
      "General Healthcare System",
      "Metropolitan General Hospital"
    ],
    "telecom": [
      {
        "system": "phone",
        "value": "555-HOSPITAL",
        "use": "work"
      },
      {
        "system": "phone",
        "value": "555-123-4567",
        "use": "work"
      },
      {
        "system": "email",
        "value": "info@generalhospital.com",
        "use": "work"
      },
      {
        "system": "fax",
        "value": "555-123-4568",
        "use": "work"
      },
      {
        "system": "url",
        "value": "https://www.generalhospital.com",
        "use": "work"
      }
    ],
    "address": [
      {
        "use": "work",
        "type": "both",
        "line": ["123 Healthcare Drive", "Medical Campus"],
        "city": "New York",
        "state": "NY",
        "postalCode": "10001",
        "country": "US"
      },
      {
        "use": "work",
        "type": "postal",
        "line": ["PO Box 12345"],
        "city": "New York",
        "state": "NY",
        "postalCode": "10001-2345",
        "country": "US"
      }
    ],
    "partOf": {
      "reference": "Organization/parent-health-system",
      "display": "Metropolitan Health System"
    },
    "contact": [
      {
        "purpose": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/contactentity-type",
              "code": "ADMIN",
              "display": "Administrative"
            }
          ]
        },
        "name": {
          "use": "official",
          "family": "Johnson",
          "given": ["Sarah", "L."]
        },
        "telecom": [
          {
            "system": "phone",
            "value": "555-123-4567",
            "use": "work"
          },
          {
            "system": "email",
            "value": "sarah.johnson@generalhospital.com",
            "use": "work"
          }
        ]
      },
      {
        "purpose": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/contactentity-type",
              "code": "HR",
              "display": "Human Resource"
            }
          ]
        },
        "name": {
          "use": "official",
          "family": "Brown",
          "given": ["Michael", "R."]
        },
        "telecom": [
          {
            "system": "phone",
            "value": "555-123-4569",
            "use": "work"
          },
          {
            "system": "email",
            "value": "hr@generalhospital.com",
            "use": "work"
          }
        ]
      }
    ],
    "endpoint": [
      {
        "reference": "Endpoint/hospital-fhir-endpoint",
        "display": "FHIR R4 Endpoint"
      },
      {
        "reference": "Endpoint/hospital-hl7-endpoint",
        "display": "HL7 v2.5 Interface"
      }
    ]
  }
}

script:post-response {
  if (res.status === 200) {
    console.log("✅ Organization updated successfully");
    console.log("Organization ID:", res.body.id);
    console.log("Updated Name:", res.body.name);
    console.log("Active:", res.body.active);
    console.log("Type:", res.body.type?.[0]?.coding?.[0]?.display);
    console.log("Aliases:", res.body.alias?.join(", "));
    console.log("Contact Methods:", res.body.telecom?.length || 0);
    console.log("Addresses:", res.body.address?.length || 0);
    console.log("Contact Persons:", res.body.contact?.length || 0);
    console.log("Endpoints:", res.body.endpoint?.length || 0);
    
    if (res.body.partOf) {
      console.log("Part Of:", res.body.partOf.display);
    }
  } else {
    console.log("❌ Failed to update organization:", res.status, res.body);
  }
}
