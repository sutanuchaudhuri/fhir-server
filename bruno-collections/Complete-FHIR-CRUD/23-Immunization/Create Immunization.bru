meta {
  name: Create Immunization
  type: http
  seq: 49
}

post {
  url: {{baseUrl}}/{{fhirVersion}}/Immunization
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Immunization",
    "identifier": [
      {
        "system": "http://example.org/immunization-identifier",
        "value": "IMM-COVID-2024-001"
      }
    ],
    "status": "completed",
    "vaccineCode": {
      "coding": [
        {
          "system": "http://hl7.org/fhir/sid/cvx",
          "code": "208",
          "display": "COVID-19, mRNA, LNP-S, PF, 30 mcg/0.3 mL dose"
        },
        {
          "system": "http://hl7.org/fhir/sid/ndc",
          "code": "59267-1000-02",
          "display": "Pfizer-BioNTech COVID-19 Vaccine"
        }
      ],
      "text": "Pfizer-BioNTech COVID-19 mRNA Vaccine"
    },
    "patient": {
      "reference": "Patient/{{lastCreatedPatientId}}",
      "display": "John Michael Doe"
    },
    "encounter": {
      "reference": "Encounter/{{lastCreatedEncounterId}}",
      "display": "Vaccination Visit"
    },
    "occurrenceDateTime": "2024-01-15T14:30:00Z",
    "recorded": "2024-01-15T14:35:00Z",
    "primarySource": true,
    "reportOrigin": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/immunization-origin",
          "code": "provider",
          "display": "Other Provider"
        }
      ]
    },
    "location": {
      "reference": "Location/{{lastCreatedLocationId}}",
      "display": "Vaccination Clinic"
    },
    "manufacturer": {
      "display": "Pfizer-BioNTech"
    },
    "lotNumber": "FF1234",
    "expirationDate": "2024-12-31",
    "site": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/v3-ActSite",
          "code": "LA",
          "display": "left arm"
        }
      ]
    },
    "route": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/v3-RouteOfAdministration",
          "code": "IM",
          "display": "Injection, intramuscular"
        }
      ]
    },
    "doseQuantity": {
      "value": 0.3,
      "unit": "mL",
      "system": "http://unitsofmeasure.org",
      "code": "mL"
    },
    "performer": [
      {
        "function": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/v2-0443",
              "code": "OP",
              "display": "Ordering Provider"
            }
          ]
        },
        "actor": {
          "reference": "Practitioner/{{lastCreatedPractitionerId}}",
          "display": "Dr. Emily Smith"
        }
      },
      {
        "function": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/v2-0443",
              "code": "AP",
              "display": "Administering Provider"
            }
          ]
        },
        "actor": {
          "reference": "Practitioner/nurse-practitioner-456",
          "display": "Susan Brown, NP"
        }
      }
    ],
    "note": [
      {
        "text": "Patient tolerated vaccination well. No immediate adverse reactions observed. Advised to monitor for side effects and return if any concerns."
      }
    ],
    "reasonCode": [
      {
        "coding": [
          {
            "system": "http://snomed.info/sct",
            "code": "840539006",
            "display": "Disease caused by severe acute respiratory syndrome coronavirus 2"
          }
        ]
      }
    ],
    "reasonReference": [
      {
        "reference": "Observation/covid-risk-assessment-123"
      }
    ],
    "isSubpotent": false,
    "subpotentReason": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/immunization-subpotent-reason",
            "code": "partial",
            "display": "Partial Dose"
          }
        ]
      }
    ],
    "education": [
      {
        "documentType": "VIS",
        "reference": "http://example.org/vis/covid-19-mrna",
        "publicationDate": "2024-01-01",
        "presentationDate": "2024-01-15"
      }
    ],
    "programEligibility": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/immunization-program-eligibility",
            "code": "ineligible",
            "display": "Not Eligible"
          }
        ]
      }
    ],
    "fundingSource": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/immunization-funding-source",
          "code": "private",
          "display": "Private"
        }
      ]
    },
    "reaction": [
      {
        "date": "2024-01-15T15:00:00Z",
        "detail": {
          "reference": "Observation/vaccine-reaction-123"
        },
        "reported": false
      }
    ],
    "protocolApplied": [
      {
        "series": "COVID-19 Primary Series",
        "authority": {
          "reference": "Organization/cdc-immunization-authority"
        },
        "targetDisease": [
          {
            "coding": [
              {
                "system": "http://snomed.info/sct",
                "code": "840539006",
                "display": "Disease caused by severe acute respiratory syndrome coronavirus 2"
              }
            ]
          }
        ],
        "doseNumberPositiveInt": 1,
        "seriesDosesPositiveInt": 2
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    console.log("✅ Immunization created successfully");
    console.log("Immunization ID:", res.body.id);
    console.log("Status:", res.body.status);
    console.log("Vaccine:", res.body.vaccineCode?.text || res.body.vaccineCode?.coding?.[0]?.display);
    console.log("Patient:", res.body.patient?.display);
    console.log("Date:", res.body.occurrenceDateTime);
    console.log("Location:", res.body.location?.display);
    console.log("Manufacturer:", res.body.manufacturer?.display);
    console.log("Lot Number:", res.body.lotNumber);
    console.log("Route:", res.body.route?.coding?.[0]?.display);
    console.log("Site:", res.body.site?.coding?.[0]?.display);
    console.log("Dose:", res.body.doseQuantity?.value, res.body.doseQuantity?.unit);
    
    if (res.body.performer && res.body.performer.length > 0) {
      console.log("\n👨‍⚕️ Performers:");
      res.body.performer.forEach((performer, index) => {
        console.log(`${index + 1}. ${performer.actor?.display} (${performer.function?.coding?.[0]?.display})`);
      });
    }
    
    if (res.body.protocolApplied && res.body.protocolApplied.length > 0) {
      console.log("\n💉 Protocol Applied:");
      res.body.protocolApplied.forEach((protocol, index) => {
        console.log(`${index + 1}. Series: ${protocol.series}`);
        console.log(`   Dose: ${protocol.doseNumberPositiveInt} of ${protocol.seriesDosesPositiveInt}`);
        console.log(`   Target Disease: ${protocol.targetDisease?.[0]?.coding?.[0]?.display}`);
      });
    }
    
    if (res.body.reasonCode && res.body.reasonCode.length > 0) {
      console.log("\n🎯 Reason Codes:");
      res.body.reasonCode.forEach((reason, index) => {
        console.log(`${index + 1}. ${reason.coding?.[0]?.display}`);
      });
    }
    
    // Store the immunization ID for other requests
    bru.setEnvVar("lastCreatedImmunizationId", res.body.id);
  } else {
    console.log("❌ Failed to create immunization:", res.status, res.body);
  }
}
