meta {
  name: Delete MedicationStatement
  type: http
  seq: 32
}

delete {
  url: {{baseUrl}}/{{fhirVersion}}/MedicationStatement/{{lastCreatedMedicationStatementId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
}

script:post-response {
  if (res.status === 200 || res.status === 204) {
    console.log("✅ MedicationStatement deleted successfully");
    console.log("Deleted MedicationStatement ID:", "{{lastCreatedMedicationStatementId}}");
    console.log("Response status:", res.status);
    
    // Clear the environment variable
    bru.setEnvVar("lastCreatedMedicationStatementId", "");
  } else if (res.status === 404) {
    console.log("⚠️  MedicationStatement not found (already deleted or never existed)");
  } else {
    console.log("❌ Failed to delete medication statement:", res.status, res.body);
  }
}
