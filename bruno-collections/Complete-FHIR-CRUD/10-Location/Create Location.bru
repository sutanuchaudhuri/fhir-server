meta {
  name: Create Location
  type: http
  seq: 100
}

post {
  url: {{baseUrl}}/{{fhirVersion}}/Location
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Location",
    "status": "active",
    "name": "Emergency Department",
    "alias": ["ED", "Emergency"],
    "description": "Emergency Department at City General Hospital",
    "mode": "instance",
    "type": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/v3-RoleCode",
            "code": "ER",
            "display": "Emergency room"
          }
        ]
      }
    ],
    "telecom": [
      {
        "system": "phone",
        "value": "555-111-9999",
        "use": "work"
      }
    ],
    "address": {
      "use": "work",
      "line": ["1234 Healthcare Blvd", "Emergency Department"],
      "city": "Chicago",
      "state": "IL",
      "postalCode": "60601",
      "country": "US"
    },
    "physicalType": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/location-physical-type",
          "code": "wi",
          "display": "Wing"
        }
      ]
    },
    "position": {
      "longitude": -87.6298,
      "latitude": 41.8781
    },
    "managingOrganization": {
      "reference": "Organization/{{lastCreatedOrganizationId}}",
      "display": "City General Hospital"
    },
    "operationalStatus": {
      "system": "http://terminology.hl7.org/CodeSystem/v2-0116",
      "code": "O",
      "display": "Occupied"
    }
  }
}

script:post-response {
  if (res.status === 201) {
    console.log("✅ Location created successfully");
    console.log("Location ID:", res.body.id);
    console.log("Name:", res.body.name);
    console.log("Type:", res.body.type?.[0]?.coding?.[0]?.display);
    console.log("Status:", res.body.status);
    
    // Store the location ID for use in other requests
    bru.setVar("lastCreatedLocationId", res.body.id);
  } else {
    console.log("❌ Failed to create location:", res.status, res.body);
  }
}
