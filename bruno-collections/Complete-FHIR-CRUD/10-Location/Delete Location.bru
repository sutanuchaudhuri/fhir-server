meta {
  name: Delete Location
  type: http
  seq: 80
}

delete {
  url: {{baseUrl}}/{{fhirVersion}}/Location/{{lastCreatedLocationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
}

script:post-response {
  if (res.status === 200 || res.status === 204) {
    console.log("✅ Location deleted successfully");
    console.log("Deleted Location ID:", "{{lastCreatedLocationId}}");
    console.log("Response status:", res.status);
    
    // Clear the environment variable
    bru.setEnvVar("lastCreatedLocationId", "");
  } else if (res.status === 404) {
    console.log("⚠️  Location not found (already deleted or never existed)");
  } else {
    console.log("❌ Failed to delete Location:", res.status, res.body);
  }
}
