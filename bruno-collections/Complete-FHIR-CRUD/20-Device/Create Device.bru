meta {
  name: Create Device
  type: http
  seq: 46
}

post {
  url: {{baseUrl}}/{{fhirVersion}}/Device
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Device",
    "identifier": [
      {
        "system": "http://example.org/device-identifier",
        "value": "MRI-PHI-3T-001"
      },
      {
        "type": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
              "code": "SNO",
              "display": "Serial Number"
            }
          ]
        },
        "system": "http://philips.com/mri-serial",
        "value": "PHI3T20240115001"
      }
    ],
    "definition": {
      "reference": "DeviceDefinition/mri-3t-definition"
    },
    "udiCarrier": [
      {
        "deviceIdentifier": "12345678901234",
        "issuer": "http://hl7.org/fhir/NamingSystem/fda-udi",
        "jurisdiction": "http://hl7.org/fhir/NamingSystem/fda-udi",
        "carrierAIDC": "MTIzNDU2Nzg5MDEyMzQ=",
        "carrierHRF": "(01)12345678901234(11)240115(17)300131(10)ABC123"
      }
    ],
    "status": "active",
    "statusReason": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/device-status-reason",
            "code": "online",
            "display": "Online"
          }
        ]
      }
    ],
    "distinctIdentifier": "PHI-MRI-3T-2024-001",
    "manufacturer": "Philips Healthcare",
    "manufactureDate": "2024-01-01",
    "expirationDate": "2034-01-01",
    "lotNumber": "LOT-2024-001",
    "serialNumber": "PHI3T20240115001",
    "deviceName": [
      {
        "name": "Philips Achieva 3.0T MRI Scanner",
        "type": "user-friendly-name"
      },
      {
        "name": "PHI-ACHIEVA-3T",
        "type": "model-name"
      }
    ],
    "modelNumber": "ACHIEVA-3T-v5.7",
    "partNumber": "PHI-MRI-3T-2024",
    "type": {
      "coding": [
        {
          "system": "http://snomed.info/sct",
          "code": "113680003",
          "display": "Magnetic resonance imaging unit"
        }
      ],
      "text": "MRI Scanner - 3 Tesla"
    },
    "specialization": [
      {
        "systemType": {
