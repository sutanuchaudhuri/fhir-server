            }
          ]
        },
        "component": {
          "value": "Main Controller"
        },
        "value": "5.7.2-2024.01"
      },
      {
        "type": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/device-version-type",
              "code": "sw",
              "display": "Software"
            }
          ]
        },
        "component": {
          "value": "Imaging Software"
        },
        "value": "ACHIEVA-SW-v12.1.5"
      }
    ],
    "property": [
      {
        "type": {
          "coding": [
            {
              "system": "http://example.org/device-property",
              "code": "magnetic-field-strength",
              "display": "Magnetic Field Strength"
            }
          ]
        },
        "valueQuantity": [
          {
            "value": 3.0,
            "unit": "T",
            "system": "http://unitsofmeasure.org",
            "code": "T"
          }
        ]
      },
      {
        "type": {
          "coding": [
            {
              "system": "http://example.org/device-property",
              "code": "bore-diameter",
              "display": "Bore Diameter"
            }
          ]
        },
        "valueQuantity": [
          {
            "value": 70,
            "unit": "cm",
            "system": "http://unitsofmeasure.org",
            "code": "cm"
          }
        ]
      }
    ],
    "owner": {
      "reference": "Organization/{{lastCreatedOrganizationId}}",
      "display": "General Hospital"
    },
    "contact": [
      {
        "system": "phone",
        "value": "555-MRI-TECH",
        "use": "work"
      },
      {
        "system": "email",
        "value": "mri.support@hospital.com",
        "use": "work"
      }
    ],
    "location": {
      "reference": "Location/{{lastCreatedLocationId}}",
      "display": "Radiology Department - MRI Suite 1"
    },
    "url": "http://hospital.com/devices/mri-scanner-001",
    "note": [
      {
        "text": "High-field 3 Tesla MRI scanner for advanced neurological and cardiac imaging. Requires specialized operator certification and regular calibration."
      }
    ],
    "safety": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/device-safety",
            "code": "mr-unsafe",
            "display": "MR Unsafe"
          }
        ]
      }
    ],
    "parent": {
      "reference": "Device/mri-main-system"
    }
  }
}

script:post-response {
  if (res.status === 201) {
    console.log("✅ Device created successfully");
    console.log("Device ID:", res.body.id);
    console.log("Status:", res.body.status);
    console.log("Manufacturer:", res.body.manufacturer);
    console.log("Model:", res.body.modelNumber);
    console.log("Serial Number:", res.body.serialNumber);
    console.log("Device Type:", res.body.type?.text || res.body.type?.coding?.[0]?.display);
    console.log("Owner:", res.body.owner?.display);
    console.log("Location:", res.body.location?.display);
    
    if (res.body.deviceName && res.body.deviceName.length > 0) {
      console.log("\n📱 Device Names:");
      res.body.deviceName.forEach((name, index) => {
        console.log(`${index + 1}. ${name.name} (${name.type})`);
      });
    }
    
    if (res.body.version && res.body.version.length > 0) {
      console.log("\n💿 Versions:");
      res.body.version.forEach((version, index) => {
        console.log(`${index + 1}. ${version.type?.coding?.[0]?.display}: ${version.value} (${version.component?.value})`);
      });
    }
    
    if (res.body.property && res.body.property.length > 0) {
      console.log("\n⚙️ Properties:");
      res.body.property.forEach((prop, index) => {
        const qty = prop.valueQuantity?.[0];
        console.log(`${index + 1}. ${prop.type?.coding?.[0]?.display}: ${qty?.value} ${qty?.unit}`);
      });
    }
    
    // Store the device ID for other requests
    bru.setEnvVar("lastCreatedDeviceId", res.body.id);
  } else {
    console.log("❌ Failed to create device:", res.status, res.body);
  }
}
