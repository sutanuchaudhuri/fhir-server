            {
              "system": "http://snomed.info/sct",
              "code": "182777000",
              "display": "Magnetic resonance imaging of head"
            }
          ]
        },
        "version": "5.7.2"
      }
    ],
    "version": [
      {
        "type": {
          "coding": [
