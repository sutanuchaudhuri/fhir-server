meta {
  name: Delete Medication
  type: http
  seq: 76
}

delete {
  url: {{baseUrl}}/{{fhirVersion}}/Medication/{{lastCreatedMedicationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
}

script:post-response {
  if (res.status === 200 || res.status === 204) {
    console.log("✅ Medication deleted successfully");
    console.log("Deleted Medication ID:", "{{lastCreatedMedicationId}}");
    console.log("Response status:", res.status);
    
    // Clear the environment variable
    bru.setEnvVar("lastCreatedMedicationId", "");
  } else if (res.status === 404) {
    console.log("⚠️  Medication not found (already deleted or never existed)");
  } else {
    console.log("❌ Failed to delete Medication:", res.status, res.body);
  }
}
