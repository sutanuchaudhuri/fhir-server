meta {
  name: Create Medication
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/{{fhirVersion}}/Medication
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Medication",
    "identifier": [
      {
        "system": "http://example.org/medication-identifier",
        "value": "MED-LISINOPRIL-10MG-001"
      }
    ],
    "code": {
      "coding": [
        {
          "system": "http://www.nlm.nih.gov/research/umls/rxnorm",
          "code": "197361",
          "display": "Lisinopril 10 MG Oral Tablet"
        },
        {
          "system": "http://hl7.org/fhir/sid/ndc",
          "code": "0093-1530-01",
          "display": "Lisinopril 10mg Tablet"
        }
      ],
      "text": "Lisinopril 10mg Oral Tablet"
    },
    "status": "active",
    "manufacturer": {
      "reference": "Organization/pharmaceutical-company-123",
      "display": "Teva Pharmaceuticals"
    },
    "form": {
      "coding": [
        {
          "system": "http://snomed.info/sct",
          "code": "385055001",
          "display": "Tablet"
        }
      ]
    },
    "amount": {
      "numerator": {
        "value": 30,
        "unit": "tablet",
        "system": "http://terminology.hl7.org/CodeSystem/v3-orderableDrugForm",
        "code": "TAB"
      },
      "denominator": {
        "value": 1,
        "unit": "bottle",
        "system": "http://unitsofmeasure.org",
        "code": "{bottle}"
      }
    },
    "ingredient": [
      {
        "itemCodeableConcept": {
          "coding": [
            {
              "system": "http://www.nlm.nih.gov/research/umls/rxnorm",
              "code": "29046",
              "display": "Lisinopril"
            }
          ]
        },
        "isActive": true,
        "strength": {
          "numerator": {
            "value": 10,
            "unit": "mg",
            "system": "http://unitsofmeasure.org",
            "code": "mg"
          },
          "denominator": {
            "value": 1,
            "unit": "tablet",
            "system": "http://terminology.hl7.org/CodeSystem/v3-orderableDrugForm",
            "code": "TAB"
          }
        }
      }
    ],
    "batch": {
      "lotNumber": "LOT123456",
      "expirationDate": "2025-12-31"
    }
  }
}

script:post-response {
  if (res.status === 201) {
    console.log("✅ Medication created successfully");
    console.log("Medication ID:", res.body.id);
    console.log("Status:", res.body.status);
    console.log("Code:", res.body.code?.text || res.body.code?.coding?.[0]?.display);
    console.log("Manufacturer:", res.body.manufacturer?.display);
    console.log("Form:", res.body.form?.coding?.[0]?.display);
    
    if (res.body.amount) {
      console.log("Amount:", res.body.amount.numerator?.value, res.body.amount.numerator?.unit, "per", res.body.amount.denominator?.value, res.body.amount.denominator?.unit);
    }
    
    if (res.body.ingredient && res.body.ingredient.length > 0) {
      console.log("\n💊 Ingredients:");
      res.body.ingredient.forEach((ingredient, index) => {
        const name = ingredient.itemCodeableConcept?.coding?.[0]?.display;
        const strength = ingredient.strength;
        console.log(`${index + 1}. ${name}`);
        console.log(`   Active: ${ingredient.isActive}`);
        if (strength) {
          console.log(`   Strength: ${strength.numerator?.value}${strength.numerator?.unit} per ${strength.denominator?.value} ${strength.denominator?.unit}`);
        }
      });
    }
    
    if (res.body.batch) {
      console.log("\n📦 Batch Information:");
      console.log("Lot Number:", res.body.batch.lotNumber);
      console.log("Expiration Date:", res.body.batch.expirationDate);
    }
    
    // Store the medication ID for other requests
    bru.setEnvVar("lastCreatedMedicationId", res.body.id);
  } else {
    console.log("❌ Failed to create medication:", res.status, res.body);
  }
}
