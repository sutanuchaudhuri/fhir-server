meta {
  name: Create Slot
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/{{fhirVersion}}/Slot
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Slot",
    "identifier": [
      {
        "system": "http://example.org/slot-identifier",
        "value": "SLOT-2024-0115-001"
      }
    ],
    "serviceCategory": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/service-category",
            "code": "17",
            "display": "General Practice"
          }
        ]
      }
    ],
    "serviceType": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/service-type",
            "code": "124",
            "display": "General Practice"
          }
        ]
      }
    ],
    "specialty": [
      {
        "coding": [
          {
            "system": "http://snomed.info/sct",
            "code": "394814009",
            "display": "General practice"
          }
        ]
      }
    ],
    "appointmentType": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/v2-0276",
          "code": "ROUTINE",
          "display": "Routine appointment"
        }
      ]
    },
    "schedule": {
      "reference": "Schedule/schedule-dr-smith-2024",
      "display": "Dr. Smith's Schedule - January 2024"
    },
    "status": "free",
    "start": "2024-01-20T09:00:00Z",
    "end": "2024-01-20T09:30:00Z",
    "overbooked": false,
    "comment": "Available 30-minute slot for routine consultation"
  }
}

script:post-response {
  if (res.status === 201) {
    console.log("✅ Slot created successfully");
    console.log("Slot ID:", res.body.id);
    console.log("Status:", res.body.status);
    console.log("Service Category:", res.body.serviceCategory?.[0]?.coding?.[0]?.display);
    console.log("Service Type:", res.body.serviceType?.[0]?.coding?.[0]?.display);
    console.log("Specialty:", res.body.specialty?.[0]?.coding?.[0]?.display);
    console.log("Appointment Type:", res.body.appointmentType?.coding?.[0]?.display);
    console.log("Schedule:", res.body.schedule?.display);
    console.log("Start Time:", res.body.start);
    console.log("End Time:", res.body.end);
    console.log("Duration:", new Date(res.body.end) - new Date(res.body.start), "milliseconds");
    console.log("Overbooked:", res.body.overbooked);
    console.log("Comment:", res.body.comment);
    
    // Store the slot ID for other requests
    bru.setEnvVar("lastCreatedSlotId", res.body.id);
  } else {
    console.log("❌ Failed to create slot:", res.status, res.body);
  }
}
