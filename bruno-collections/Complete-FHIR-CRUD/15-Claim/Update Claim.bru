meta {
  name: Update Claim
  type: http
  seq: 82
}

put {
  url: {{baseUrl}}/{{fhirVersion}}/Claim/{{lastCreatedClaimId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

