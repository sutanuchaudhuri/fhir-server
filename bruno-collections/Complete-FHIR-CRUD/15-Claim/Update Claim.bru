script:post-response {
  if (res.status === 200) {
    const claim = res.body;
    console.log("✅ Claim updated successfully");
    console.log("Claim ID:", claim.id);
    
    // Display updated details
    console.log("\n📋 Updated Claim Details:");
    console.log("Status:", claim.status);
    console.log("Type:", claim.type?.coding?.[0]?.display);
    console.log("SubType:", claim.subType?.coding?.[0]?.display);
    console.log("Use:", claim.use);
    console.log("Priority:", claim.priority?.coding?.[0]?.display);
    console.log("Patient:", claim.patient?.display || claim.patient?.reference);
    console.log("Provider:", claim.provider?.display || claim.provider?.reference);
    console.log("Insurer:", claim.insurer?.display || claim.insurer?.reference);
    
    // Display billable period
    if (claim.billablePeriod) {
      console.log("\n📅 Updated Billable Period:");
      console.log("Start:", claim.billablePeriod.start);
      console.log("End:", claim.billablePeriod.end);
    }
    
    // Display care team
    if (claim.careTeam && claim.careTeam.length > 0) {
      console.log("\n👥 Updated Care Team:");
      claim.careTeam.forEach((member, index) => {
        console.log(`  ${index + 1}. ${member.provider?.display || member.provider?.reference}`);
        console.log(`     Role: ${member.role?.coding?.[0]?.display || "Not specified"}`);
        console.log(`     Responsible: ${member.responsible ? "Yes" : "No"}`);
        if (member.qualification) {
          console.log(`     Qualification: ${member.qualification.coding?.[0]?.display}`);
        }
      });
    }
    
    // Display diagnoses
    if (claim.diagnosis && claim.diagnosis.length > 0) {
      console.log("\n🏥 Updated Diagnoses:");
      claim.diagnosis.forEach((diagnosis, index) => {
        console.log(`  ${index + 1}. ${diagnosis.diagnosisCodeableConcept?.coding?.[0]?.display} (${diagnosis.diagnosisCodeableConcept?.coding?.[0]?.code})`);
        if (diagnosis.type && diagnosis.type.length > 0) {
          console.log(`     Type: ${diagnosis.type[0].coding?.[0]?.display}`);
        }
      });
    }
    
    // Display procedures
    if (claim.procedure && claim.procedure.length > 0) {
      console.log("\n🔬 Updated Procedures:");
      claim.procedure.forEach((procedure, index) => {
        console.log(`  ${index + 1}. ${procedure.procedureCodeableConcept?.coding?.[0]?.display} (${procedure.procedureCodeableConcept?.coding?.[0]?.code})`);
        console.log(`     Date: ${procedure.date}`);
      });
    }
    
    // Display insurance
    if (claim.insurance && claim.insurance.length > 0) {
      console.log("\n🛡️  Updated Insurance:");
      claim.insurance.forEach((insurance, index) => {
        console.log(`  ${index + 1}. ${insurance.coverage?.display || insurance.coverage?.reference}`);
        console.log(`     Focal: ${insurance.focal ? "Yes" : "No"}`);
        console.log(`     Member ID: ${insurance.identifier?.value || "Not specified"}`);
        if (insurance.preAuthRef && insurance.preAuthRef.length > 0) {
          console.log(`     Pre-Auth: ${insurance.preAuthRef.join(", ")}`);
        }
      });
    }
    
    // Display items summary
    if (claim.item && claim.item.length > 0) {
      console.log("\n💰 Updated Items:");
      let totalNet = 0;
      claim.item.forEach((item, index) => {
        console.log(`  ${index + 1}. ${item.productOrService?.coding?.[0]?.display} (${item.productOrService?.coding?.[0]?.code})`);
        console.log(`     Quantity: ${item.quantity?.value || "Not specified"}`);
        console.log(`     Unit Price: $${item.unitPrice?.value || "0.00"}`);
        console.log(`     Net: $${item.net?.value || "0.00"}`);
        
        if (item.net?.value) {
          totalNet += item.net.value;
        }
        
        if (item.detail && item.detail.length > 0) {
          console.log(`     Details: ${item.detail.length} line item(s)`);
        }
      });
      console.log(`  Total Calculated: $${totalNet.toFixed(2)}`);
    }
    
    // Display total
    if (claim.total) {
      console.log("\n💵 Updated Total:");
      console.log("Amount:", `$${claim.total.value} ${claim.total.currency}`);
    }
    
    // Display accident information
    if (claim.accident) {
      console.log("\n🚑 Accident Information:");
      console.log("Date:", claim.accident.date);
      console.log("Type:", claim.accident.type?.coding?.[0]?.display);
      console.log("Location:", claim.accident.locationAddress?.text);
    }
    
    console.log("\n📊 Update Summary:");
    console.log("New Version:", claim.meta?.versionId || "Unknown");
    console.log("Last Updated:", claim.meta?.lastUpdated || "Unknown");
    console.log("Care Team Members:", claim.careTeam?.length || 0);
    console.log("Diagnoses:", claim.diagnosis?.length || 0);
    console.log("Procedures:", claim.procedure?.length || 0);
    console.log("Insurance Plans:", claim.insurance?.length || 0);
    console.log("Line Items:", claim.item?.length || 0);
    console.log("Supporting Info:", claim.supportingInfo?.length || 0);
    
  } else {
    console.log("❌ Failed to update Claim:", res.status, res.body);
  }
}
