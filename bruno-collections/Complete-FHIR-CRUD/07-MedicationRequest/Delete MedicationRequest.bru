meta {
  name: Delete MedicationRequest
  type: http
  seq: 72
}

delete {
  url: {{baseUrl}}/{{fhirVersion}}/MedicationRequest/{{lastCreatedMedicationRequestId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
}

script:post-response {
  if (res.status === 200 || res.status === 204) {
    console.log("✅ MedicationRequest deleted successfully");
    console.log("Deleted MedicationRequest ID:", "{{lastCreatedMedicationRequestId}}");
    console.log("Response status:", res.status);
    
    // Clear the environment variable
    bru.setEnvVar("lastCreatedMedicationRequestId", "");
  } else if (res.status === 404) {
    console.log("⚠️  MedicationRequest not found (already deleted or never existed)");
  } else {
    console.log("❌ Failed to delete MedicationRequest:", res.status, res.body);
  }
}
