meta {
  name: Create Condition
  type: http
  seq: 60
}

post {
  url: {{baseUrl}}/{{fhirVersion}}/Condition
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Condition",
    "clinicalStatus": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
          "code": "active",
          "display": "Active"
        }
      ]
    },
    "verificationStatus": {
      "coding": [
        {
          "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
          "code": "confirmed",
          "display": "Confirmed"
        }
      ]
    },
    "category": [
      {
        "coding": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/condition-category",
            "code": "encounter-diagnosis",
            "display": "Encounter Diagnosis"
          }
        ]
      }
    ],
    "severity": {
      "coding": [
        {
          "system": "http://snomed.info/sct",
          "code": "255604002",
          "display": "Mild"
        }
      ]
    },
    "code": {
      "coding": [
        {
          "system": "http://snomed.info/sct",
          "code": "38341003",
          "display": "Hypertensive disorder"
        }
      ]
    },
    "subject": {
      "reference": "Patient/{{lastCreatedPatientId}}",
      "display": "John Doe"
    },
    "encounter": {
      "reference": "Encounter/{{lastCreatedEncounterId}}"
    },
    "onsetDateTime": "2024-01-01T00:00:00Z",
    "recordedDate": "2024-01-15T14:30:00Z",
    "recorder": {
      "reference": "Practitioner/{{lastCreatedPractitionerId}}",
      "display": "Dr. Emily Smith"
    }
  }
}

script:post-response {
  if (res.status === 201) {
    console.log("✅ Condition created successfully");
    console.log("Condition ID:", res.body.id);
    console.log("Code:", res.body.code?.coding?.[0]?.display);
    console.log("Clinical Status:", res.body.clinicalStatus?.coding?.[0]?.display);
    console.log("Severity:", res.body.severity?.coding?.[0]?.display);
    
    // Store the condition ID for use in other requests
    bru.setVar("lastCreatedConditionId", res.body.id);
  } else {
    console.log("❌ Failed to create condition:", res.status, res.body);
  }
}
