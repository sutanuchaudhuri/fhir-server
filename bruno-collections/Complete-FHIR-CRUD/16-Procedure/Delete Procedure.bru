meta {
  name: Delete Procedure
  type: http
  seq: 70
}

delete {
  url: {{baseUrl}}/{{fhirVersion}}/Procedure/{{lastCreatedProcedureId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
}

script:post-response {
  if (res.status === 200 || res.status === 204) {
    console.log("✅ Procedure deleted successfully");
    console.log("Deleted Procedure ID:", "{{lastCreatedProcedureId}}");
    console.log("Response status:", res.status);
    
    // Clear the environment variable
    bru.setEnvVar("lastCreatedProcedureId", "");
  } else if (res.status === 404) {
    console.log("⚠️  Procedure not found (already deleted or never existed)");
  } else {
    console.log("❌ Failed to delete Procedure:", res.status, res.body);
  }
}
