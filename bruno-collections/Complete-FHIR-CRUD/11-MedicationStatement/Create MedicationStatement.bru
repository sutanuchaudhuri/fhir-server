meta {
  name: Create MedicationStatement
  type: http
  seq: 110
}

post {
  url: {{baseUrl}}/{{fhirVersion}}/MedicationStatement
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "MedicationStatement",
    "status": "active",
    "medicationCodeableConcept": {
      "coding": [
        {
          "system": "http://www.nlm.nih.gov/research/umls/rxnorm",
          "code": "197361",
          "display": "Lisinopril 10 MG Oral Tablet"
        }
      ]
    },
    "subject": {
      "reference": "Patient/{{lastCreatedPatientId}}",
      "display": "John Doe"
    },
    "context": {
      "reference": "Encounter/{{lastCreatedEncounterId}}"
    },
    "effectiveDateTime": "2024-01-15",
    "dateAsserted": "2024-01-15T15:00:00Z",
    "informationSource": {
      "reference": "Practitioner/{{lastCreatedPractitionerId}}",
      "display": "Dr. Emily Smith"
    },
    "derivedFrom": [
      {
        "reference": "MedicationRequest/{{lastCreatedMedicationRequestId}}"
      }
    ],
    "reasonReference": [
      {
        "reference": "Condition/{{lastCreatedConditionId}}",
        "display": "Hypertensive disorder"
      }
    ],
    "dosage": [
      {
        "text": "Take one tablet by mouth once daily in the morning",
        "timing": {
          "repeat": {
            "frequency": 1,
            "period": 1,
            "periodUnit": "d",
            "when": ["MORN"]
          }
        },
        "route": {
          "coding": [
            {
              "system": "http://snomed.info/sct",
              "code": "26643006",
              "display": "Oral route"
            }
          ]
        },
        "doseAndRate": [
          {
            "type": {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/dose-rate-type",
                  "code": "ordered",
                  "display": "Ordered"
                }
              ]
            },
            "doseQuantity": {
              "value": 10,
              "unit": "mg",
              "system": "http://unitsofmeasure.org",
              "code": "mg"
            }
          }
        ]
      }
    ],
    "note": [
      {
        "text": "Patient reports good compliance with medication. No side effects reported."
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    console.log("✅ MedicationStatement created successfully");
    console.log("MedicationStatement ID:", res.body.id);
    console.log("Medication:", res.body.medicationCodeableConcept?.coding?.[0]?.display);
    console.log("Status:", res.body.status);
    console.log("Effective Date:", res.body.effectiveDateTime);
    
    // Store the medication statement ID for use in other requests
    bru.setVar("lastCreatedMedicationStatementId", res.body.id);
  } else {
    console.log("❌ Failed to create medication statement:", res.status, res.body);
  }
}
